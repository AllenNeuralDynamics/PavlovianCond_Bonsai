<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="TaskLogicPath" />
        <Property Name="RigPath" />
        <Property Name="SessionPath" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="AllenNeuralDynamics.Core:ReadSchemas.bonsai">
        <TaskLogicPath>C:\Users\neurogears\source\repos\AllenNeuralDynamics\PavlovianCond_Bonsai\local\AindPavlovianConitioningTaskLogic.json</TaskLogicPath>
        <RigPath>C:\Users\neurogears\source\repos\AllenNeuralDynamics\PavlovianCond_Bonsai\local\AindPavlovianConditioningRig.json</RigPath>
        <SessionPath>C:\Users\neurogears\source\repos\AllenNeuralDynamics\PavlovianCond_Bonsai\local\AindBehaviorSessionModel.json</SessionPath>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RawSessionSchema</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="IntProperty">
          <Value>0</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RawTaskLogicSchema</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RawRigSchema</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RawSessionSchema</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>